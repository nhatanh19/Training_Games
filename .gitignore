# ==============================================================================
# Gitignore for Unity Projects & Training Repository
# Repository Root: Training_Games
# ==============================================================================

# --- Unity Generated Directories in source projects ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity generic builds (ignoring local binaries, but allowing WebGL web folders)
[Bb]uild/
[Bb]uilds/

# Allow WebGL builds placed under Week folders for GitHub Pages
!**/Week_*/Build/
!**/Week_*/Build/**
!**/Week_*/Build_WebGL/
!**/Week_*/Build_WebGL/**
!**/Week_*/TemplateData/
!**/Week_*/TemplateData/**
!**/Week_*/index.html
!**/Week_*/Build_WebGL/index.html

# --- Asset / Package Cache ---
AssetBundles/
assets_gen/
ExportedObj/
.utmp/

# --- Gradle & Mobile Specific Builds ---
.gradle/
*.apk
*.aab
*.unitypackage

# --- Visual Studio / VS Code / JetBrains Rider / IDE Files ---
.vs/
.idea/
.vscode/
.vsconfig
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity Autogenerated Solution and Project Files for VS and Rider
ExportedProject/
.consulo/
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Unity Crash & Profiling Reports ---
sysinfo.txt
*.stackdump
CrashReports/

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Temporary & Backup Files ---
*.bak
*.swp
*~
*.orig
