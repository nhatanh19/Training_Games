# ==============================================================================
# Unity .gitignore for Week_3 Project
# ==============================================================================

# Unity Generated Directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should NOT be ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code cache & config
.vs/
.idea/
.vscode/
.vsconfig
.gradle/

# Autogenerated IDE solution & project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.pdb.meta
*.spark
*.spark.meta
*.meta.spark
*.mdb
*.mdb.meta
*.pidb.meta

# Unity Crash & Profiling Reports
sysinfo.txt
*.stackdump
CrashReports/

# Builds & Packages
*.apk
*.aab
*.unitypackage
*.app

# OS Generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
